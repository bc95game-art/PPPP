<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout android:id="@id/app_bar_layout"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:elevation="6.0dip">
        <androidx.appcompat.widget.Toolbar android:theme="@style/AppBarOverlay"
          android:id="@id/toolbar"
          android:background="@color/colorActionBar"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          app:popupTheme="@style/PopupOverlay" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
      android:fitsSystemWindows="true"
      android:layout_width="match_parent" android:layout_height="match_parent"
      app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout android:orientation="vertical"
          android:padding="12.0dip"
          android:layout_width="match_parent" android:layout_height="wrap_content">

            <!-- Network Traffic Card -->
            <com.google.android.material.card.MaterialCardView
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:layout_marginBottom="12.0dip"
              app:cardCornerRadius="12.0dip"
              app:cardElevation="2.0dip"
              app:strokeWidth="0.0dip">
                <LinearLayout android:orientation="vertical"
                  android:padding="16.0dip"
                  android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:textSize="12.0sp" android:textStyle="bold"
                      android:textColor="@color/colorPrimary"
                      android:text="@string/traffic"
                      android:letterSpacing="0.08"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:layout_marginBottom="12.0dip" />

                    <TableLayout android:id="@id/table"
                      android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:stretchColumns="1">

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/bytes_sent" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/bytes_sent" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/bytes_rcvd" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/bytes_rcvd" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:id="@id/ipv6_bytes_sent_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/ipv6_bytes_sent" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/ipv6_bytes_sent" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:id="@id/ipv6_bytes_rcvd_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/ipv6_bytes_rcvd" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/ipv6_bytes_rcvd" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:id="@id/ipv6_bytes_percentage_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/ipv6_bytes_percentage" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/ipv6_bytes_percentage" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                    </TableLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Packets & Connections Card -->
            <com.google.android.material.card.MaterialCardView
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:layout_marginBottom="12.0dip"
              app:cardCornerRadius="12.0dip"
              app:cardElevation="2.0dip"
              app:strokeWidth="0.0dip">
                <LinearLayout android:orientation="vertical"
                  android:padding="16.0dip"
                  android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:textSize="12.0sp" android:textStyle="bold"
                      android:textColor="@color/colorPrimary"
                      android:text="@string/connections"
                      android:letterSpacing="0.08"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:layout_marginBottom="12.0dip" />

                    <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:stretchColumns="1">

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/pkts_sent" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/pkts_sent" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/pkts_rcvd" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/pkts_rcvd" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:id="@id/row_pkts_dropped" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/pkts_dropped" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/pkts_dropped" android:textSize="13.0sp"
                              android:textColor="@color/statusError"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:id="@id/row_dropped_connections" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/dropped_connections" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/dropped_connections" android:textSize="13.0sp"
                              android:textColor="@color/statusError"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/tot_connections" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/tot_connections" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                    </TableLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DNS Card -->
            <com.google.android.material.card.MaterialCardView
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:layout_marginBottom="12.0dip"
              app:cardCornerRadius="12.0dip"
              app:cardElevation="2.0dip"
              app:strokeWidth="0.0dip">
                <LinearLayout android:orientation="vertical"
                  android:padding="16.0dip"
                  android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:textSize="12.0sp" android:textStyle="bold"
                      android:textColor="@color/colorPrimary"
                      android:text="@string/dns_server"
                      android:letterSpacing="0.08"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:layout_marginBottom="12.0dip" />

                    <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:stretchColumns="1">

                        <TableRow android:id="@id/dns_server_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/dns_server" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/dns_server" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:id="@id/dns_queries_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/dns_queries" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/dns_queries" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                    </TableLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Memory Card -->
            <com.google.android.material.card.MaterialCardView
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:layout_marginBottom="12.0dip"
              app:cardCornerRadius="12.0dip"
              app:cardElevation="2.0dip"
              app:strokeWidth="0.0dip">
                <LinearLayout android:orientation="vertical"
                  android:padding="16.0dip"
                  android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:textSize="12.0sp" android:textStyle="bold"
                      android:textColor="@color/colorPrimary"
                      android:text="@string/memory_usage"
                      android:letterSpacing="0.08"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:layout_marginBottom="12.0dip" />

                    <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:stretchColumns="1">

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/heap_usage" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/heap_usage" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/memory_usage" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/mem_usage" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/low_memory" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/low_mem_detected" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                        <TableRow android:id="@id/open_sockets_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
                            <TextView android:textStyle="bold" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:text="@string/open_sockets" android:layout_weight="0.5"
                              android:paddingEnd="8.0dip" />
                            <TextView android:id="@id/open_sockets" android:textSize="13.0sp"
                              android:layout_width="0.0dip" android:layout_height="wrap_content"
                              android:layout_weight="0.5" android:textIsSelectable="true" />
                        </TableRow>

                    </TableLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@id/alloc_stats"
              android:visibility="gone"
              android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:layout_marginTop="8.0dip"
              android:layout_marginBottom="16.0dip"
              android:textSize="12.0sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
