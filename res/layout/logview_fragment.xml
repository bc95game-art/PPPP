<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical"
  android:layout_width="fill_parent" android:layout_height="fill_parent"
  android:background="#FF0D1117"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Terminal Header Bar -->
    <LinearLayout android:orientation="horizontal"
      android:layout_width="fill_parent" android:layout_height="44.0dip"
      android:background="#FF161B22"
      android:paddingLeft="16.0dip" android:paddingRight="16.0dip"
      android:gravity="center_vertical">

        <!-- macOS-style traffic lights -->
        <TextView android:layout_width="12.0dip" android:layout_height="12.0dip"
          android:background="#FFFF5F57" android:text=""
          android:layout_marginRight="6.0dip" />
        <TextView android:layout_width="12.0dip" android:layout_height="12.0dip"
          android:background="#FFFFBD2E" android:text=""
          android:layout_marginRight="6.0dip" />
        <TextView android:layout_width="12.0dip" android:layout_height="12.0dip"
          android:background="#FF28C840" android:text=""
          android:layout_marginRight="16.0dip" />

        <TextView android:textSize="11.0sp"
          android:fontFamily="monospace"
          android:textColor="#FF8B949E"
          android:text="PCAPdroid — System Log"
          android:layout_width="0.0dip" android:layout_height="wrap_content"
          android:layout_weight="1.0" />

        <TextView android:id="@id/log_line_count"
          android:textSize="10.0sp"
          android:fontFamily="monospace"
          android:textColor="#FF3FB950"
          android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Separator line -->
    <View android:layout_width="fill_parent" android:layout_height="1.0dip"
      android:background="#FF21262D" />

    <ScrollView android:id="@id/scrollView"
      android:layout_width="fill_parent" android:layout_height="fill_parent"
      android:fillViewport="true"
      android:scrollbarThumbVertical="@color/colorPrimary">

        <TextView android:textSize="11.5sp"
          android:fontFamily="monospace"
          android:id="@id/log"
          android:layout_width="fill_parent" android:layout_height="wrap_content"
          android:padding="14.0dip"
          android:lineSpacingMultiplier="1.5"
          android:textIsSelectable="true"
          android:textColor="#FF00D26A"
          android:background="#FF0D1117" />
    </ScrollView>

</LinearLayout>
