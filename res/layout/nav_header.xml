<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:orientation="vertical"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/drawer_background_gradient"
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Deep overlay layer -->
    <View android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#CC000A18"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

    <!-- Tri-color neon glow bar at top -->
    <LinearLayout android:orientation="horizontal"
      android:layout_width="match_parent" android:layout_height="4.0dip"
      android:layout_marginTop="0.0dip"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent">
        <View android:layout_width="0.0dip" android:layout_height="4.0dip"
          android:layout_weight="1.0"
          android:background="#FF1565C0" />
        <View android:layout_width="0.0dip" android:layout_height="4.0dip"
          android:layout_weight="1.0"
          android:background="#FF00C853" />
        <View android:layout_width="0.0dip" android:layout_height="4.0dip"
          android:layout_weight="1.0"
          android:background="#FFE53935" />
    </LinearLayout>

    <!-- Binary code decorative text top-right -->
    <TextView android:textSize="8.0sp"
      android:fontFamily="monospace"
      android:textColor="#1800C8FF"
      android:text="01001100 00110001\n10110010 01001010\n00101100 11010011\n01110100 00111010\n10001101 01100110"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="10.0dip" android:layout_marginEnd="8.0dip"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <!-- Logo container with gradient ring -->
    <com.google.android.material.card.MaterialCardView
      android:layout_width="76.0dip" android:layout_height="76.0dip"
      android:layout_marginBottom="14.0dip"
      app:cardCornerRadius="38.0dip"
      app:cardElevation="12.0dip"
      app:cardBackgroundColor="#FF001235"
      app:strokeColor="#FF1565C0"
      app:strokeWidth="2.0dip"
      app:layout_constraintBottom_toTopOf="@id/app_name"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent">
        <ImageView android:gravity="center"
          android:layout_width="60.0dip" android:layout_height="60.0dip"
          android:src="@drawable/ic_logo"
          android:layout_gravity="center"
          android:padding="8.0dip" />
    </com.google.android.material.card.MaterialCardView>

    <!-- App Name with gradient-inspired look -->
    <TextView android:textSize="17.0sp" android:textStyle="bold"
      android:textColor="#FFFFFFFF"
      android:id="@id/app_name"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginBottom="6.0dip"
      android:text="@string/app_name"
      android:letterSpacing="0.08"
      app:layout_constraintBottom_toTopOf="@id/app_version_bar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom bar with version info -->
    <LinearLayout android:orientation="horizontal"
      android:id="@id/app_version_bar"
      android:layout_width="match_parent" android:layout_height="38.0dip"
      android:background="#CC001030"
      android:paddingLeft="16.0dip" android:paddingRight="16.0dip"
      android:gravity="center_vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent">

        <!-- Blue dot -->
        <View android:layout_width="7.0dip" android:layout_height="7.0dip"
          android:background="#FF1565C0"
          android:layout_marginRight="5.0dip" />

        <!-- Green dot -->
        <View android:layout_width="7.0dip" android:layout_height="7.0dip"
          android:background="#FF00C853"
          android:layout_marginRight="5.0dip" />

        <!-- Red dot -->
        <View android:layout_width="7.0dip" android:layout_height="7.0dip"
          android:background="#FFE53935"
          android:layout_marginRight="10.0dip" />

        <TextView android:textSize="10.0sp"
          android:fontFamily="monospace"
          android:textColor="#AA00C8FF"
          android:text="PCAPdroid"
          android:layout_width="0.0dip" android:layout_height="wrap_content"
          android:layout_weight="1.0"
          android:letterSpacing="0.1" />

        <TextView android:textSize="11.0sp"
          android:fontFamily="monospace"
          android:textColor="#CCFFFFFF"
          android:id="@id/app_version"
          android:focusable="false"
          android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
